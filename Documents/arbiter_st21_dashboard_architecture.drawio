        <mxCell id="legend_text" value="&lt;b&gt;Legend:&lt;/b&gt; solid = synchronous AWS call · dashed = managed/encryption/external · pink edges = JWT/HTTP via CloudFront · teal edges = Bedrock Runtime (Guardrails-attached) · amber edges = scanner pipeline · indigo dashed = external JIRA via Atlassian MCP plugin (not invoked by any Lambda)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontStyle=0;fontColor=#1E293B;fillColor=none;strokeColor=none;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="1550" y="715" width="800" height="60" as="geometry" />
        </mxCell>

